<Page x:Class="VoicevoxHelper.App.Views.ScriptRewriteInputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="台本リライト - 入力" FontSize="20" FontWeight="Bold" />
        <TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="200" />
        <Button Content="リライト実行" Command="{Binding RewriteCommand}" />
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
