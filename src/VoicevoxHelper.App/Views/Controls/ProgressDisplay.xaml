<UserControl x:Class="VoicevoxHelper.App.Views.Controls.ProgressDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" />
        <TextBlock Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
