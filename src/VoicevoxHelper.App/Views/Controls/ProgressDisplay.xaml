<UserControl x:Class="VoicevoxHelper.App.Views.Controls.ProgressDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ProgressBar Width="70"
                     Height="10"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding Progress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Margin="0,0,8,0" />
        <TextBlock Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
