<Page x:Class="VoicevoxHelper.App.Views.DictionaryRegistrationExecutionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="辞書API登録 - 実行" FontSize="20" FontWeight="Bold" />
        <Button Content="登録実行" Command="{Binding ExecuteCommand}" />
        <TextBlock Text="{Binding ResultMessage}" />
        <TextBlock Text="{Binding SuccessCount, StringFormat=成功件数: {0}}" />
        <TextBlock Text="{Binding FailureCount, StringFormat=失敗件数: {0}}" />
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
