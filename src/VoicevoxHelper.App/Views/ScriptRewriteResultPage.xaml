<Page x:Class="VoicevoxHelper.App.Views.ScriptRewriteResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="台本リライト - 結果" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="元の台本" FontWeight="Bold" />
        <TextBox Text="{Binding OriginalScript}" AcceptsReturn="True" Height="120" IsReadOnly="True" />
        <TextBlock Text="リライト結果" FontWeight="Bold" />
        <TextBox Text="{Binding RewriteResult}" AcceptsReturn="True" Height="120" IsReadOnly="True" />
        <Button Content="コピー" Command="{Binding CopyCommand}" />
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
