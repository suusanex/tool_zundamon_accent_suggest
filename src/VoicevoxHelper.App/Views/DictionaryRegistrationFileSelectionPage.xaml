<Page x:Class="VoicevoxHelper.App.Views.DictionaryRegistrationFileSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="辞書API登録 - ファイル選択" FontSize="20" FontWeight="Bold" />
        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="読み込み" Command="{Binding LoadCommand}" />
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
