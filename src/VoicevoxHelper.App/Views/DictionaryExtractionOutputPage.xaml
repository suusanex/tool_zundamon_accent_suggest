<Page x:Class="VoicevoxHelper.App.Views.DictionaryExtractionOutputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="辞書候補抽出 - 出力" FontSize="20" FontWeight="Bold" />
        <ComboBox SelectedValue="{Binding OutputFormat}" SelectedValuePath="Content">
            <ComboBoxItem Content="CSV" />
            <ComboBoxItem Content="JSON" />
        </ComboBox>
        <TextBox Text="{Binding OutputText}" AcceptsReturn="True" Height="200" />
        <Button Content="ファイル保存" Command="{Binding SaveToFileCommand}" />
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
