<Page x:Class="VoicevoxHelper.App.Views.DictionaryExtractionPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:VoicevoxHelper.App.Views.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="辞書候補抽出 - プレビュー" FontSize="20" FontWeight="Bold" />
        <DataGrid ItemsSource="{Binding Candidates}" AutoGenerateColumns="True" Height="200" />
        <StackPanel Orientation="Horizontal">
            <Button Content="戻る" Command="{Binding BackCommand}" />
            <Button Content="次へ" Command="{Binding NextCommand}" />
        </StackPanel>
        <controls:ErrorDisplay Message="{Binding ErrorMessage}" />
    </StackPanel>
</Page>
